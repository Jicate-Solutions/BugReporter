{
  "name": "@boobalan_jkkn/bug-reporter-sdk",
  "version": "1.3.3",
  "description": "Bug reporting SDK with screenshot, file attachments, console logging, network trace, and leaderboard - Complete bug bounty platform for teams",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external lucide-react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external lucide-react",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bug-reporter",
    "error-tracking",
    "react",
    "nextjs",
    "bug-tracking",
    "error-reporting",
    "crash-reporting",
    "screenshot",
    "console-logs",
    "jkkn"
  ],
  "author": {
    "name": "Boobalan JKKN",
    "email": "boobalan@jkkn.ac.in"
  },
  "license": "MIT",
  "peerDependencies": {
    "lucide-react": "^0.400.0 || ^0.500.0 || ^0.552.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@boobalan_jkkn/shared": "file:../shared",
    "html2canvas": "^1.4.1",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.0.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
