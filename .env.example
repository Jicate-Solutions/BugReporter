# Environment variable NAMES only. Never put a real value in this file.
# (Older variables are not listed here yet; this file starts with the triage lane.)

# Triage lane: the bearer token the JICATE Windows runner sends to
# /api/internal/triage/claim and /api/internal/triage/complete. Generated by the
# Director (at least 32 characters, e.g. `openssl rand -hex 32`), set in Vercel
# and in the runner's triage.env. Unset = both routes answer 503.
# Must differ from CRON_SECRET.
TRIAGE_RUNNER_TOKEN=
