{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "./packages/shared/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Its own package, with its own tsconfig, dependencies and build. The
    // app's include globs (**/*.ts) would otherwise compile it, and it
    // resolves imports like html2canvas from its own node_modules — which is
    // gitignored and never installed on a deploy, so the app built locally
    // and failed on Vercel.
    "packages/bug-reporter-sdk"
  ]
}
